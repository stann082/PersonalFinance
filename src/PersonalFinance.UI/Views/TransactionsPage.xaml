<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalFinance.UI.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Transactions">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*" Padding="10">

            <Grid Grid.Row="0"
                ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                VerticalOptions="Center"
                ColumnSpacing="12">

                <Label Grid.Column="0" Text="From" VerticalOptions="Center" />
                <DatePicker Grid.Column="1" Date="{Binding StartDate}" />

                <Label Grid.Column="2" Text="To" VerticalOptions="Center" Margin="16,0,0,0" />
                <DatePicker Grid.Column="3" Date="{Binding StopDate}" />

                <Button Grid.Column="4"
                    Text="Refresh Transactions"
                    Command="{Binding LoadTransactionsCommand}"
                    HorizontalOptions="End" />
            </Grid>

            <CollectionView
                Grid.Row="1"
                x:Name="TransactionsList"
                ItemsSource="{Binding Transactions}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8">
                            <Label Text="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
