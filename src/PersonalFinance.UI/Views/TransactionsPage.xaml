<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalFinance.UI.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PersonalFinance.UI.ViewModels"
    Title="Transactions">

    <ContentPage.BindingContext>
        <viewmodels:TransactionModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*"
              Padding="10">

            <!-- Top bar: filters / refresh -->
            <HorizontalStackLayout
                Grid.Row="0"
                Spacing="10"
                VerticalOptions="Center">

                <Label Text="Transactions"
                       FontAttributes="Bold"
                       FontSize="20" />

                <Button Text="Refresh"
                        Command="{Binding LoadTransactionsCommand}"
                        HorizontalOptions="EndAndExpand" />
            </HorizontalStackLayout>

            <!-- List of transactions -->
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Transactions}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <!-- Left column: description + date + category -->
                            <VerticalStackLayout Grid.Column="0" Grid.RowSpan="2">
                                <Label Text="{Binding Description}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}"
                                       FontSize="12"
                                       TextColor="Gray" />
                                <Label Text="{Binding Category}"
                                       FontSize="12"
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <!-- Right column: amount -->
                            <Label Grid.Column="1"
                                   Grid.RowSpan="2"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Text="{Binding Amount, StringFormat='{}{0:C}'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
