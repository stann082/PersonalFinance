<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalFinance.UI.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Transactions">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,Auto,*"
              Padding="10">

            <HorizontalStackLayout Grid.Row="0"
                                   Spacing="8"
                                   VerticalOptions="Center">
                <Label Text="From"
                       VerticalOptions="Center" />
                <DatePicker Date="{Binding StartDate}" />

                <Label Text="To"
                       VerticalOptions="Center"
                       Margin="16,0,0,0" />
                <DatePicker Date="{Binding StopDate}" />
            </HorizontalStackLayout>
            
            <HorizontalStackLayout
                Grid.Row="1"
                Spacing="10"
                VerticalOptions="Center">

                <Label Text="Transactions"
                       FontAttributes="Bold"
                       FontSize="20" />

                <Button Text="Refresh"
                        Command="{Binding LoadTransactionsCommand}"
                        HorizontalOptions="EndAndExpand" />
            </HorizontalStackLayout>

            <CollectionView
                Grid.Row="2"
                x:Name="TransactionsList"
                ItemsSource="{Binding Transactions}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8"
                              ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto">

                            <!-- 🔹 Double-tap recognizer on the whole row -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    NumberOfTapsRequired="2"
                                    Command="{Binding BindingContext.OpenTransactionCommand, Source={x:Reference TransactionsList}}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <!-- Left column: description + date + category -->
                            <VerticalStackLayout Grid.Column="0" Grid.RowSpan="2">
                                <Label Text="{Binding Description}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}"
                                       FontSize="12"
                                       TextColor="Gray" />
                                <Label Text="{Binding Category}"
                                       FontSize="12"
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <!-- Right column: amount -->
                            <Label Grid.Column="1"
                                   Grid.RowSpan="2"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Text="{Binding Amount, StringFormat='{}{0:C}'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
