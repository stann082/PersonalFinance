<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PersonalFinance.UI.ViewModels"
             x:Class="PersonalFinance.UI.Views.TransactionDetailsPage"
             x:DataType="viewmodels:TransactionDetailsViewModel"
             Title="Transaction Details">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="10">

                <Label Text="Transaction Details"
                       FontSize="20"
                       FontAttributes="Bold" />

                <Label Text="Date" FontAttributes="Bold" />
                <Label Text="{Binding Transaction.Date, StringFormat='{}{0:yyyy-MM-dd}'}" />

                <Label Text="Amount" FontAttributes="Bold" />
                <Label Text="{Binding Transaction.Amount, StringFormat='{}{0:C}'}" />

                <Label Text="Description" FontAttributes="Bold" />
                <Entry Text="{Binding Description}"
                       Placeholder="Description" />

                <Label Text="Category" FontAttributes="Bold" />
                <Entry Text="{Binding Category}"
                       Placeholder="Category" />

                <Label Text="Recurring"
                       FontAttributes="Bold"
                       IsVisible="{Binding CanEditRecurring}" />
                <Switch IsToggled="{Binding IsRecurring}"
                        IsVisible="{Binding CanEditRecurring}"
                        HorizontalOptions="Start" />

                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="End">
                    <Button Text="Cancel"
                            Command="{Binding CloseCommand}" />
                    <Button Text="Save"
                            Command="{Binding SaveCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
