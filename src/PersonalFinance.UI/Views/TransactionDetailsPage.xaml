<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PersonalFinance.Domain.Models;assembly=PersonalFinance.Domain"
             x:Class="PersonalFinance.UI.Views.TransactionDetailsPage"
             x:DataType="models:Transaction"
             Title="Transaction Details">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="10">

                <Label Text="Transaction Details"
                       FontSize="20"
                       FontAttributes="Bold" />

                <Label Text="ID" FontAttributes="Bold" />
                <Label Text="{Binding TransactionId}" />

                <Label Text="Date" FontAttributes="Bold" />
                <Label Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" />

                <Label Text="Description" FontAttributes="Bold" />
                <Label Text="{Binding Description}" />

                <Label Text="Category" FontAttributes="Bold" />
                <Label Text="{Binding Category}" />

                <Label Text="Amount" FontAttributes="Bold" />
                <Label Text="{Binding Amount, StringFormat='{}{0:C}'}" />

                <Label Text="Balance" FontAttributes="Bold" />
                <Label Text="{Binding Balance, StringFormat='{}{0:C}'}" />

                <Label Text="Recurring" FontAttributes="Bold" />
                <Label>
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsRecurring}" Value="True">
                            <Setter Property="Text" Value="Yes" />
                        </DataTrigger>

                        <DataTrigger TargetType="Label" Binding="{Binding IsRecurring}" Value="False">
                            <Setter Property="Text" Value="No" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Button Text="Close"
                        HorizontalOptions="End"
                        Clicked="OnCloseClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>